<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 크기.

  minWidth/minHeight  — 이보다 작게는 못 놓는다
  minResizeWidth/Height — 손으로 줄일 수 있는 한계. ⚠️ 이 값이 없으면
                          minWidth 밑으로 못 줄여서, 꾹 눌러도 크기가 안 바뀐다.
  maxResizeWidth/Height — 늘릴 수 있는 한계 (안드로이드 12부터)
  targetCellWidth/Height — 처음 놓일 때의 칸 수
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="300dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:initialLayout="@layout/knit_widget"
    android:previewLayout="@layout/knit_widget"
    android:configure="com.suki.knittinglog.KnitWidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/knit_widget_description"
    android:updatePeriodMillis="1800000" />
